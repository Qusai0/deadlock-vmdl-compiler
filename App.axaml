<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="DeadlockVmdlCompiler.App"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <!-- The existing studio palette, shared by the workspace and its dialogs. -->
        <SolidColorBrush x:Key="StudioWindow" Color="#11151D"/>
        <SolidColorBrush x:Key="StudioPanel" Color="#1A2230"/>
        <SolidColorBrush x:Key="StudioInput" Color="#131822"/>
        <SolidColorBrush x:Key="StudioViewport" Color="#0E1219"/>
        <SolidColorBrush x:Key="StudioBorder" Color="#2D394E"/>
        <SolidColorBrush x:Key="StudioBorderStrong" Color="#3B4B64"/>
        <SolidColorBrush x:Key="StudioText" Color="#E2E8F0"/>
        <SolidColorBrush x:Key="StudioTextMuted" Color="#94A3B8"/>
        <SolidColorBrush x:Key="StudioTextSoft" Color="#CBD5E1"/>
        <SolidColorBrush x:Key="StudioAccent" Color="#60A5FA"/>
        <SolidColorBrush x:Key="StudioPortrait" Color="#263247"/>
        <SolidColorBrush x:Key="StudioPrimary" Color="#255899"/>
        <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBackground" Color="#1A2230"/>
        <SolidColorBrush x:Key="AutoCompleteBoxSuggestionsListBorderBrush" Color="#3B4B64"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBackground" Color="#1A2230"/>
        <SolidColorBrush x:Key="ComboBoxDropDownBorderBrush" Color="#3B4B64"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundPointerOver" Color="#263247"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelected" Color="#255899"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPointerOver" Color="#306CB5"/>
        <SolidColorBrush x:Key="ComboBoxItemBackgroundSelectedPressed" Color="#1C4578"/>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />

        <!-- Shared type and surface hierarchy. -->
        <Style Selector="Border.studio-card">
            <Setter Property="Background" Value="{StaticResource StudioPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="Border.studio-inset">
            <Setter Property="Background" Value="{StaticResource StudioInput}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
        </Style>
        <Style Selector="TextBlock.field-hint">
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextMuted}"/>
        </Style>
        <Style Selector="TextBlock.body-copy">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{StaticResource StudioTextSoft}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Global Studio Styling -->
        
        <!-- Standard Action Button -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#212A3B" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#324058" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,5" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2B384F" />
            <Setter Property="BorderBrush" Value="#465775" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#171D29" />
            <Setter Property="BorderBrush" Value="#273347" />
        </Style>
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#151A24" />
            <Setter Property="BorderBrush" Value="#202736" />
            <Setter Property="Foreground" Value="#555E6D" />
        </Style>

        <!-- Primary Accent Button (Compile) -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#255899" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#3D7BC9" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#306CB5" />
            <Setter Property="BorderBrush" Value="#5795E6" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="Button.primary:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#1C4578" />
        </Style>
        <Style Selector="Button.utility">
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
        <Style Selector="Button.subtle-toggle:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>
        <Style Selector="Button.subtle-toggle:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
        </Style>

        <!-- TextBox -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Background" Value="#171D2A" />
        </Style>

        <!-- ComboBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="ComboBox:pointerover /template/ Border#Background">
            <Setter Property="Background" Value="#19202E" />
            <Setter Property="BorderBrush" Value="#41506B" />
        </Style>

        <Style Selector="AutoCompleteBox">
            <Setter Property="Background" Value="{StaticResource StudioInput}"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="5"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style Selector="ListBox">
            <Setter Property="Background" Value="{StaticResource StudioPanel}"/>
            <Setter Property="BorderBrush" Value="{StaticResource StudioBorder}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource StudioText}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource StudioPortrait}"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource StudioPrimary}"/>
        </Style>

        <!-- CheckBox -->
        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#E2E8F0" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="CheckBox /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#131822" />
            <Setter Property="BorderBrush" Value="#2D384D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle">
            <Setter Property="BorderBrush" Value="#60A5FA" />
            <Setter Property="Background" Value="#1A2230" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Border#NormalRectangle">
            <Setter Property="Background" Value="#255899" />
            <Setter Property="BorderBrush" Value="#60A5FA" />
        </Style>
        <Style Selector="CheckBox:checked /template/ Path#CheckGlyph">
            <Setter Property="Fill" Value="#FFFFFF" />
            <Setter Property="Stroke" Value="#FFFFFF" />
        </Style>

        <!-- Expander: Totally transparent header without ANY black hover box -->
        <Style Selector="Expander">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="2,4" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ Border#Root">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Expander /template/ ToggleButton#ExpanderHeader:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
